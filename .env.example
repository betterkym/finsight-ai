# FinSight AI — 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 아래 키 값을 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요.

# OpenDART API (재무제표 데이터)
# 발급: https://opendart.fss.or.kr
DART_API_KEY=your_dart_api_key_here

# 한국은행 ECOS API (기준금리·국고채)
# 발급: https://ecos.bok.or.kr
ECOS_API_KEY=your_ecos_api_key_here

# Anthropic API (LLM 리포트 생성 — Week 4)
# 발급: https://console.anthropic.com
# 주의: 반드시 claude-haiku-4-5 모델만 사용
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 네이버 검색 트렌드 API (Consumer Attention Signal — Week 3)
# 발급: https://developers.naver.com → 애플리케이션 등록 → datalab.search 권한
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
