# FinSight AI — 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 아래 키 값을 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요.

# OpenDART API (재무제표 데이터)
# 발급: https://opendart.fss.or.kr
DART_API_KEY=your_dart_api_key_here

# 한국은행 ECOS API (기준금리·국고채)
# 발급: https://ecos.bok.or.kr
ECOS_API_KEY=your_ecos_api_key_here

# Anthropic API (LLM 리포트 생성 — Week 4)
# 발급: https://console.anthropic.com
# 주의: 반드시 claude-haiku-4-5 모델만 사용
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 네이버 검색 트렌드 API (Consumer Attention Signal — Week 3)
# 발급: https://developers.naver.com → 애플리케이션 등록 → datalab.search 권한
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# KRX 수급 데이터
# 현재 pykrx/KRX 접속 정책상 계정 정보가 필요한 경우가 있습니다.
KRX_ID=your_krx_id_here
KRX_PW=your_krx_password_here

# KOSIS 국가통계포털 API (국내 산업/소비/물가 세부 proxy)
# 발급: https://kosis.kr/openapi
# KOSIS_FOOD_TABLE_ID는 사용할 식품/소비/산업 통계표 ID를 지정할 때 사용합니다.
KOSIS_API_KEY=your_kosis_api_key_here
KOSIS_FOOD_TABLE_ID=

# KAMIS 농산물유통정보 Open API (원재료/농산물 가격 proxy)
# 발급: https://www.kamis.or.kr/customer/reference/openapi_list.do
KAMIS_API_ID=your_kamis_cert_id_here
KAMIS_API_KEY=your_kamis_cert_key_here

# FRED API (USD/KRW, 원자재 proxy 등)
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Trading Economics API (국가별 매크로/원자재 확장)
# 발급: https://tradingeconomics.com/analytics/api.aspx
TRADING_ECONOMICS_KEY=your_trading_economics_key_here

# UN Comtrade API (HS코드 기반 수출입 proxy)
# 발급: https://comtradeplus.un.org
UN_COMTRADE_KEY=your_un_comtrade_key_here
